{
	"cli": {
		"version": ">= 14.0.2",
		"appVersionSource": "remote"
	},

	"build": {
		"base": {
			"ios": {
				"image": "latest"
			}
		},

		"development": {
			"extends": "base",
			"developmentClient": true,
			"distribution": "internal",
			"autoIncrement": true,
			"ios": {
				"simulator": true
			},
			"android": {
				"buildType": "apk"
			},
			"env": {
				"PILOT_BUILD": "true"
			}
		},

		"staging": {
			"extends": "base",
			"distribution": "internal",
			"autoIncrement": true,
			"ios": {
				"simulator": false
			},
			"android": {
				"buildType": "app-bundle"
			},
			"env": {
				"APP_ENV": "staging",
				"API_URL": "https://us-central1-leafy-loader-444703-d0.cloudfunctions.net",
				"PILOT_BUILD": "true"
			}
		},

		"production": {
			"extends": "base",
			"distribution": "store",
			"autoIncrement": true,
			"ios": {
				"simulator": false
			},
			"android": {
				"buildType": "app-bundle"
			},
			"env": {
				"APP_ENV": "production",
				"API_URL": "https://us-central1-sibklcms-prod.cloudfunctions.net",
				"PILOT_BUILD": "false"
			}
		},

		"pilot": {
			"extends": "base",
			"distribution": "store",
			"autoIncrement": true,
			"ios": {
				"simulator": false
			},
			"android": {
				"buildType": "app-bundle"
			},
			"env": {
				"APP_ENV": "production",
				"API_URL": "https://us-central1-sibklcms-prod.cloudfunctions.net",
				"PILOT_BUILD": "true"
			}
		}
	},

	"submit": {
		"staging": {
			"ios": {
				"appleId": "tech@sibkl.org.my",
				"ascAppId": "6761758983",
				"appleTeamId": "HR28GRB742"
			},
			"android": {
				"track": "internal"
			}
		},

		"production": {
			"ios": {
				"appleId": "tech@sibkl.org.my",
				"ascAppId": "6762274718",
				"appleTeamId": "HR28GRB742"
			},
			"android": {
				"track": "internal"
			}
		},

		"pilot": {
			"ios": {
				"appleId": "tech@sibkl.org.my",
				"ascAppId": "6762274718",
				"appleTeamId": "HR28GRB742"
			},
			"android": {
				"track": "internal"
			}
		}
	}
}
